              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "type": "user_property",
                    "key": "email",
                    "display_name": "Email",
                    "data_type": "string",
                    "is_auto_property": false
